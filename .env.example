# Скопируйте этот файл в .env и измените значения.
SECRET_KEY=replace-with-a-long-random-secret
FLASK_DEBUG=0
# Set to 1 behind HTTPS in production. Keep 0 only for local HTTP development.
SESSION_COOKIE_SECURE=0

# Первоначальный администратор создаётся при первом запуске.
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=replace-with-a-unique-password-at-least-10-chars
INITIAL_ADMIN_NAME=Администратор

# Координаты одного общего места практики. Пока пустые — отметки отключены.
# Пример: PRACTICE_LAT=50.123456
# Пример: PRACTICE_LON=72.123456
PRACTICE_LAT=
PRACTICE_LON=
PRACTICE_RADIUS_M=100
MAX_GPS_ACCURACY_M=100

# По умолчанию используется SQLite для локального теста.
# Для production укажите PostgreSQL, например:
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/practice_attendance
